# OpenRouter API key for Nemotron / other models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model ID (change this to swap models via OpenRouter)
OPENROUTER_MODEL_ID=nvidia/nemotron-3-super-120b-a12b:free

# Flask configuration (for dummy app)
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Agent configurations
AGENT_LOG_LEVEL=INFO
OWL_ONTOLOGY_PATH=./config/ontology.json

# Docker sandbox settings
SANDBOX_USER=cerverus_user
WORKSPACE_DIR=./workspace
